QMainWindow {
    background: #f3f3f3;
    color: #1f1f1f;
}

QWidget {
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 12px;
}

QMenuBar {
    background: transparent;
    border: none;
    padding: 2px 4px;
}

QMenuBar::item {
    padding: 6px 10px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background: #ededed;
}

QMenu {
    background: #ffffff;
    border: 1px solid #e7e7e7;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 14px 7px 9px;
    border-radius: 6px;
}

QMenu::item:selected {
    background: #f1f5f9;
}

QMenu::separator {
    height: 1px;
    background: #ececec;
    margin: 6px 8px;
}

QLabel#pageTitleLabel {
    font-size: 24px;
    font-weight: 700;
    color: #1f1f1f;
}

QLabel#pageSubtitleLabel {
    font-size: 12px;
    color: #6a6a6a;
}

QLabel#emptyStateLabel {
    line-height: 1.4;
}

QFrame#toolbarContainer,
QFrame#secondaryActionsContainer,
QFrame#statsPanel,
QFrame#bottomPanel {
    background: #fbfbfb;
    border: 1px solid #e7e7e7;
    border-radius: 12px;
}

QFrame#tableContainer {
    background: #ffffff;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
}

QFrame#commandGroup,
QFrame#pathGroup,
QFrame#runtimeGroup {
    background: #ffffff;
    border: 1px solid #ececec;
    border-radius: 10px;
}

QPushButton#toolbarButton {
    min-height: 32px;
    border: 1px solid #d8d8d8;
    border-radius: 8px;
    background: #ffffff;
    color: #1f1f1f;
    padding: 2px 12px;
    font-weight: 600;
}

QPushButton#toolbarButton:hover {
    background: #f6f6f6;
    border-color: #cfcfcf;
}

QPushButton#toolbarButton:pressed {
    background: #efefef;
}

QPushButton#toolbarButton[buttonRole="primary"] {
    background: #0f6cbd;
    color: #ffffff;
    border-color: #0f6cbd;
}

QPushButton#toolbarButton[buttonRole="primary"]:hover {
    background: #115ea3;
    border-color: #115ea3;
}

QPushButton#toolbarButton[buttonRole="danger"] {
    background: #fff4f2;
    color: #a4262c;
    border-color: #f1c6c3;
}

QPushButton#toolbarButton[buttonRole="danger"]:hover {
    background: #fde7e9;
}

QPushButton#toolbarButton[buttonRole="ghost"] {
    background: #ffffff;
    color: #2b2b2b;
    border-color: #e1e1e1;
}

QPushButton#toolbarButton:disabled {
    background: #f5f5f5;
    color: #a0a0a0;
    border-color: #ebebeb;
}

QLabel#groupCaptionLabel {
    color: #616161;
    font-size: 11px;
    font-weight: 600;
    margin-bottom: 2px;
}

QLabel#currentPathLabel {
    min-height: 26px;
    padding: 8px 10px;
    background: #f8f8f8;
    border: 1px solid #ededed;
    border-radius: 8px;
    color: #2b2b2b;
}

QLabel#statsLabel {
    color: #3a3a3a;
    font-size: 12px;
    padding: 6px 10px;
    background: #f7f7f7;
    border: 1px solid #ededed;
    border-radius: 8px;
}

QLabel#runtimeStateLabel {
    color: #1f1f1f;
    font-size: 12px;
    font-weight: 700;
    padding: 0;
    background: transparent;
    border: none;
}

QLabel#runtimeMetaLabel {
    color: #6a6a6a;
    font-size: 12px;
    padding: 0;
    background: transparent;
    border: none;
}

QCheckBox {
    spacing: 6px;
    color: #1f1f1f;
    font-weight: 600;
}


QTableView#resultsTable {
    border: none;
    background: #ffffff;
    alternate-background-color: #fcfcfc;
    selection-background-color: #dbeafe;
    selection-color: #1f1f1f;
    gridline-color: transparent;
    padding: 0;
}

QTableView#resultsTable::item {
    padding: 8px 10px;
    border-bottom: 1px solid #f1f1f1;
}

QHeaderView::section {
    background: #fafafa;
    color: #555555;
    padding: 12px 10px;
    border: none;
    border-bottom: 1px solid #e8e8e8;
    font-weight: 700;
}

QLabel#emptyStateLabel {
    margin: 24px;
    padding: 24px 12px;
    color: #666666;
    font-size: 13px;
    background: transparent;
    border: none;
}

QProgressBar#progressBar {
    border: none;
    background: #e7e7e7;
    border-radius: 3px;
}

QProgressBar#progressBar::chunk {
    background: #0f6cbd;
    border-radius: 3px;
}

QStatusBar#statusBar {
    border: none;
    background: transparent;
    color: #5f5f5f;
    padding-left: 4px;
    font-size: 12px;
}

QDialog {
    background: #f3f3f3;
}

QFrame#dialogCard {
    background: #ffffff;
    border: 1px solid #e7e7e7;
    border-radius: 14px;
}

QLabel#dialogHeaderLabel {
    color: #1f1f1f;
    font-size: 18px;
    font-weight: 700;
}

QLabel#dialogLabel {
    color: #616161;
    font-size: 12px;
    font-weight: 600;
}

QLabel#dialogStatusLabel {
    color: #404040;
    background: #f8f8f8;
    border: 1px solid #ececec;
    border-radius: 10px;
    padding: 9px 11px;
}

QLineEdit {
    min-height: 36px;
    border: 1px solid #d6d6d6;
    border-radius: 9px;
    background: #ffffff;
    padding: 0 10px;
}

QLineEdit:focus {
    border-color: #7fb7e7;
}

QPushButton#dialogPrimaryButton,
QPushButton#dialogSecondaryButton {
    min-height: 36px;
    padding: 0 14px;
    border-radius: 9px;
    font-weight: 600;
}

QPushButton#dialogPrimaryButton {
    background: #0f6cbd;
    color: #ffffff;
    border: 1px solid #0f6cbd;
}

QPushButton#dialogPrimaryButton:hover {
    background: #115ea3;
}

QPushButton#dialogSecondaryButton {
    background: #ffffff;
    color: #1f1f1f;
    border: 1px solid #d8d8d8;
}

QPushButton#dialogSecondaryButton:hover {
    background: #f6f6f6;
}

QProgressBar#dialogProgressBar {
    min-height: 8px;
    border: none;
    border-radius: 4px;
    background: #e7e7e7;
}

QProgressBar#dialogProgressBar::chunk {
    background: #0f6cbd;
    border-radius: 4px;
}


QMenuBar#appMenuBar {
    background: transparent;
    border: none;
    padding: 0 2px 6px 2px;
}

QMenuBar#appMenuBar::item {
    min-height: 28px;
    padding: 6px 12px;
    margin-right: 2px;
    border-radius: 8px;
    color: #2b2b2b;
}

QMenuBar#appMenuBar::item:selected {
    background: #ededed;
}

QMenu#appMenu {
    background: #fbfbfb;
    border: 1px solid #e5e5e5;
    border-radius: 12px;
    padding: 8px;
}

QMenu#appMenu::item {
    min-height: 28px;
    padding: 7px 18px 7px 10px;
    border-radius: 8px;
    color: #202020;
}

QMenu#appMenu::item:selected {
    background: #edf5fd;
    color: #0f3d66;
}

QMenu#appMenu::item:disabled {
    color: #9a9a9a;
    background: transparent;
}

QMenu#appMenu::separator {
    height: 1px;
    background: #ebebeb;
    margin: 7px 10px;
}
